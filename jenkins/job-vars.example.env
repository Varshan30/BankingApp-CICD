# Jenkins Pipeline Environment Variables
# Copy these into your Jenkins job configuration (Pipeline > Environment Variables)

# Container/Image settings
DOCKER_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/banking-devops/mobile-banking-backend

# AWS/EKS settings
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=banking-devops-eks
AWS_CREDENTIALS_ID=banking-aws-creds

# Pipeline toggles
TERRAFORM_ENABLED=true
TERRAFORM_AUTO_APPLY=true
ANSIBLE_ENABLED=false

# Optional Ansible bootstrap settings
ANSIBLE_PLAYBOOK=ansible/playbooks/site.yml
ANSIBLE_INVENTORY=ansible/inventory/hosts.ini
